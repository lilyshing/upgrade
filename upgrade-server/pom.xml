<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ===== 服务器端 fat jar 模块：Web 后台 + SQLite3 + 下载器分发 ===== -->
    <parent>
        <groupId>com.aipro.upgrade</groupId>
        <artifactId>upgrade-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>upgrade-server</artifactId>
    <packaging>jar</packaging>

    <name>Upgrade Server</name>
    <description>服务器端版本管理工具：独立部署的 Web 服务（管理后台 + SQLite3）</description>

    <properties>
        <main.class>com.aipro.upgrade.server.UpgradeServerMain</main.class>
    </properties>

    <dependencies>
        <!-- SQLite JDBC 驱动（含各平台 native 库，打进 fat jar） -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
        </dependency>
        <!-- BCrypt 密码哈希（后台用户密码存储） -->
        <dependency>
            <groupId>org.mindrot</groupId>
            <artifactId>jbcrypt</artifactId>
        </dependency>
        <!-- 测试 -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>upgrade-server</finalName>
        <plugins>
            <!-- 打成可执行 fat jar，包含所有依赖与 native 库 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <configuration>
                    <transformers>
                        <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                            <mainClass>${main.class}</mainClass>
                        </transformer>
                        <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                    </transformers>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
