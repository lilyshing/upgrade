@echo off
REM Force codepage 936 (GBK) so file parsing, Chinese paths and
REM PowerShell argument passing all behave like a standard Chinese Windows cmd.
chcp 936 >nul
setlocal enabledelayedexpansion

REM ============================================================
REM   Auto Upgrade Module - Bootstrap Installer (Windows)
REM   Generated by server with embedded TOOL_ID / SERVER_URL / PLATFORM
REM   No Java dependency; uses curl or PowerShell to download files
REM   NOTE: This file is served as GBK (ANSI codepage 936) so that
REM         cmd.exe parses it correctly on Chinese Windows.
REM         Keep all REM comments ASCII-only.
REM ============================================================

REM === Embedded variables (server injected) ===
set "TOOL_ID={{TOOL_ID}}"
set "SERVER_URL={{SERVER_URL}}"
set "PLATFORM={{PLATFORM}}"

REM === Parse command line arguments ===
set "INSTALL_DIR="
set "OVERRIDE_PLATFORM="
set "NO_START=0"
:parse
if "%~1"=="" goto parsed
if /i "%~1"=="--no-start" (
    set "NO_START=1"
    shift
    goto parse
)
echo %~1 | findstr /r "^--dir=" >nul && (
    set "INSTALL_DIR=%~1"
    set "INSTALL_DIR=!INSTALL_DIR:~6!"
    shift
    goto parse
)
echo %~1 | findstr /r "^--platform=" >nul && (
    set "OVERRIDE_PLATFORM=%~1"
    set "OVERRIDE_PLATFORM=!OVERRIDE_PLATFORM:~11!"
    shift
    goto parse
)
shift
goto parse
:parsed

REM Apply platform override
if defined OVERRIDE_PLATFORM set "PLATFORM=!OVERRIDE_PLATFORM!"

REM === Default install directory ===
if "!INSTALL_DIR!"=="" set "INSTALL_DIR=.\%TOOL_ID%"

REM === Platform detection ===
if /i "!PLATFORM!"=="auto" set "PLATFORM=win"

echo [INFO] tool=%TOOL_ID% platform=%PLATFORM% server=%SERVER_URL%
echo [INFO] target dir: %INSTALL_DIR%

REM === Choose download tool ===
set "DL="
where curl >nul 2>nul && set "DL=curl"
if "!DL!"=="" where powershell >nul 2>nul && set "DL=ps"
if "!DL!"=="" (
    echo [ERR] neither curl nor powershell found. exit code 6.
    exit /b 6
)

REM === Create working directory ===
if not exist "%INSTALL_DIR%" mkdir "%INSTALL_DIR%" 2>nul
if not exist "%INSTALL_DIR%" (
    echo [ERR] failed to create directory. exit code 4.
    exit /b 4
)

REM === Fetch manifest ===
set "MANIFEST=%INSTALL_DIR%\.manifest.kv"
set "BOOT_URL=%SERVER_URL%/api/bootstrap/%TOOL_ID%?platform=%PLATFORM%&format=kv"
echo [INFO] fetching manifest: "%BOOT_URL%"
REM Pass args via globals and call with NO parameters: a "call :label args"
REM performs a second percent-expansion on args, which would corrupt the
REM percent-encoded URL (e.g. %E9% seen as undefined env var -> empty).
set "DL_URL=!BOOT_URL!"
set "DL_OUT=!MANIFEST!"
set "DL_RESUME=0"
call :download
if errorlevel 1 (
    echo [ERR] failed to fetch manifest. exit code 1.
    exit /b 1
)
REM Server serves KV manifest as UTF-8; convert to local ANSI (GBK)
REM so that for /f parses Chinese file names correctly.
powershell -NoProfile -Command "$t=[IO.File]::ReadAllText('%MANIFEST%',[Text.Encoding]::UTF8); [IO.File]::WriteAllText('%MANIFEST%',$t,[Text.Encoding]::GetEncoding(936))" 2>nul
if errorlevel 1 (
    echo [ERR] manifest encoding conversion failed. exit code 1.
    exit /b 1
)

REM === Parse manifest ===
set "VER="
set "START_CMD="
set "FILE_COUNT=0"
for /f "usebackq tokens=1,* delims==" %%a in ("%MANIFEST%") do (
    if "%%a"=="VERSION" set "VER=%%b"
    if "%%a"=="START_COMMAND" set "START_CMD=%%b"
    if "%%a"=="FILE_COUNT" set "FILE_COUNT=%%b"
)
if "%FILE_COUNT%"=="0" (
    echo [ERR] manifest has no file info. exit code 1.
    exit /b 1
)
echo [INFO] version=%VER% files=%FILE_COUNT%

REM === Download files one by one ===
set "i=0"
:fileloop
set /a "i+=1"
if !i! gtr %FILE_COUNT% goto filedone

REM Extract FILE_i line from manifest
for /f "usebackq tokens=1,* delims==" %%a in ("%MANIFEST%") do (
    if "%%a"=="FILE_!i!" set "FILE_LINE=%%b"
)

REM Parse path|sha256|size
set "FNAME=!FILE_LINE!"
for /f "tokens=1,2,3 delims=|" %%a in ("!FILE_LINE!") do (
    set "FNAME=%%a"
    set "FSHA=%%b"
    set "FSIZE=%%c"
)

set "DEST=%INSTALL_DIR%\!FNAME!"
REM Create subdirectories (file path may contain nested folders)
for %%I in ("!DEST!") do if not exist "%%~dpI" mkdir "%%~dpI"

echo [INFO] download [!i!/%FILE_COUNT%] !FNAME! ...

REM Offline fallback: skip if file exists and hash matches
if exist "!DEST!" (
    call :sha256 "!DEST!" ACTUAL
    if /i "!ACTUAL!"=="!FSHA!" (
        echo [INFO] already exists and verified, skip !FNAME!
        goto fileloop
    )
)

REM URL-encode file name in one PowerShell call.
REM Do NOT encode char-by-char in batch: %S:~0,1% splits a GBK double-byte
REM character into orphan bytes that PowerShell cannot decode (U+FFFD).
for /f "delims=" %%h in ('powershell -NoProfile -Command "[uri]::EscapeDataString('!FNAME!')"') do set "ENC_NAME=%%h"
set "FILE_URL=%SERVER_URL%/api/file/tool/%TOOL_ID%/%VER%/%PLATFORM%/!ENC_NAME!"
REM Globals + parameterless call to protect percent-encoded URL
set "DL_URL=!FILE_URL!"
set "DL_OUT=!DEST!"
set "DL_RESUME=1"
call :download
if errorlevel 1 (
    echo [ERR] download failed !FNAME!. exit code 2.
    exit /b 2
)

REM SHA-256 verification
call :sha256 "!DEST!" ACTUAL
if /i "!ACTUAL!" neq "!FSHA!" (
    echo [ERR] checksum mismatch !FNAME!
    echo [ERR] expected=!FSHA!  actual=!ACTUAL!
    exit /b 3
)
echo [INFO] checksum ok !FNAME!
goto fileloop
:filedone

REM === Write log ===
set "TS=%date:~0,4%%date:~5,2%%date:~8,2%_%time:~0,2%%time:~3,2%%time:~6,2%"
set "TS=%TS: =0%"
set "LOG_FILE=%INSTALL_DIR%\install_%TS%.log"
echo [%date% %time%] install done tool=%TOOL_ID% ver=%VER% dir=%INSTALL_DIR%> "%LOG_FILE%"
echo [INFO] log: %LOG_FILE%

REM === Launch ===
if "%NO_START%"=="1" (
    echo [INFO] --no-start given, launch skipped
    exit /b 0
)

echo %START_CMD% | findstr /i "java" >nul && (
    where java >nul 2>nul || (
        echo [ERR] Java not detected, please install JDK 1.8 first. exit code 5.
        exit /b 5
    )
)
echo [INFO] launching: %START_CMD%
cd /d "%INSTALL_DIR%"
cmd /c "%START_CMD%"
exit /b %errorlevel%

REM ============================================================
REM Subroutine: download (with retry; resume optional)
REM   Inputs via globals: DL_URL, DL_OUT, DL_RESUME (1=resume)
REM   Called with NO parameters to avoid call's second percent
REM   expansion corrupting percent-encoded URLs.
REM   PowerShell branch uses only .NET 2.0 APIs so it works on
REM   Windows 7 built-in PowerShell 2.0 (no IWR cmdlet).
REM ============================================================
:download
set "URL=!DL_URL!"
set "OUT=!DL_OUT!"
set "RESUME=!DL_RESUME!"
set "RETRY=0"
:dl_retry
if "%DL%"=="curl" (
    if "%RESUME%"=="1" (
        curl -L --retry 3 -C - -o "%OUT%" "%URL%"
    ) else (
        curl -L --retry 3 -o "%OUT%" "%URL%"
    )
) else (
    if "%RESUME%"=="1" (
        REM HttpWebRequest with Range, append to existing file
        powershell -NoProfile -Command "$r=[Net.HttpWebRequest]::Create('%URL%'); if(Test-Path '%OUT%'){$r.AddRange((New-Object IO.FileInfo('%OUT%')).Length)}; $resp=$r.GetResponse(); $st=$resp.GetResponseStream(); $fs=[IO.File]::OpenWrite('%OUT%'); $fs.Seek($fs.Length,[IO.SeekOrigin]::Begin) | Out-Null; $buf=New-Object byte[] 8192; while(($n=$st.Read($buf,0,8192)) -gt 0){$fs.Write($buf,0,$n)}; $fs.Close(); $st.Close(); $resp.Close()"
    ) else (
        REM Plain overwrite download via WebClient
        powershell -NoProfile -Command "$wc=New-Object Net.WebClient; $wc.DownloadFile('%URL%','%OUT%'); $wc.Dispose()"
    )
)
if %errorlevel%==0 exit /b 0
set /a "RETRY+=1"
if !RETRY! lss 3 (
    echo [WARN] attempt !RETRY! failed, retrying...
    powershell -NoProfile -Command "Start-Sleep -Seconds (2 * [Math]::Pow(2,!RETRY!-1))" 2>nul
    if errorlevel 1 ping -n 3 127.0.0.1 >nul
    goto dl_retry
)
exit /b 1

REM ============================================================
REM Subroutine: sha256 (returns value in named variable)
REM   %1=file  %2=output variable name
REM ============================================================
:sha256
set "F=%~1"
set "VAR=%~2"
set "ACTUAL="
for /f "skip=1 tokens=* delims=" %%h in ('certutil -hashfile "!F!" SHA256 2^>nul') do (
    if "!ACTUAL!"=="" set "ACTUAL=%%h"
)
REM Line 2 of certutil output is the hash value
set "%VAR%=%ACTUAL%"
goto :eof

